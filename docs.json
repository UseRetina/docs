{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Retina docs",
  "description": "User documentation for Retina portfolio tracking, snapshots, cloud history, automation, and portfolio analysis.",
  "colors": {
    "primary": "#4648D4",
    "light": "#8B8DF0",
    "dark": "#8B8DF0"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "getting-started/introduction",
          "getting-started/quickstart",
          "getting-started/add-what-you-track"
        ]
      },
      {
        "group": "Core workflows",
        "icon": "repeat-2",
        "expanded": true,
        "pages": [
          "core/snapshots",
          "core/history-performance",
          "core/cloud-automatic-updates"
        ]
      },
      {
        "group": "Explore your portfolio",
        "icon": "layout-dashboard",
        "expanded": true,
        "pages": [
          "guides/dashboard",
          "guides/holdings",
          "guides/yield-maturities",
          "guides/polymarket",
          "guides/rewards-risk",
          "guides/ask-retina"
        ]
      },
      {
        "group": "Account and data",
        "icon": "shield-check",
        "expanded": true,
        "pages": [
          "account/privacy-security",
          "account/backup-restore-export",
          "account/coverage-troubleshooting",
          "account/pricing"
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/getting-started/beta-access", "destination": "/getting-started/quickstart" },
    { "source": "/pages/dashboard", "destination": "/guides/dashboard" },
    { "source": "/pages/polymarket", "destination": "/guides/polymarket" },
    { "source": "/pages/wallets", "destination": "/guides/holdings" },
    { "source": "/pages/protocols", "destination": "/guides/holdings" },
    { "source": "/pages/positions", "destination": "/guides/holdings" },
    { "source": "/pages/maturity-ladder", "destination": "/guides/yield-maturities" },
    { "source": "/pages/risk-scores", "destination": "/guides/rewards-risk" },
    { "source": "/pages/rewards", "destination": "/guides/rewards-risk" },
    { "source": "/pages/history", "destination": "/core/history-performance" },
    { "source": "/concepts/snapshots", "destination": "/core/snapshots" },
    { "source": "/concepts/tracker-vs-viewer", "destination": "/getting-started/introduction" },
    { "source": "/concepts/asset-classes", "destination": "/guides/holdings" },
    { "source": "/concepts/position-types", "destination": "/guides/holdings" },
    { "source": "/concepts/position-model", "destination": "/guides/holdings" },
    { "source": "/concepts/maturity", "destination": "/guides/yield-maturities" },
    { "source": "/data-sources/:slug*", "destination": "/account/coverage-troubleshooting" },
    { "source": "/privacy/local-first", "destination": "/account/privacy-security" },
    { "source": "/privacy/why-it-matters", "destination": "/account/privacy-security" },
    { "source": "/privacy/tradeoffs", "destination": "/account/privacy-security" },
    { "source": "/privacy/sync-roadmap", "destination": "/core/cloud-automatic-updates" },
    { "source": "/roadmap", "destination": "/getting-started/introduction" }
  ],
  "logo": {
    "light": "/logo/retina-lockup-on-light.svg",
    "dark": "/logo/retina-lockup-on-dark.svg"
  },
  "navbar": {
    "links": [
      { "label": "Open Retina", "href": "https://useretina.xyz" }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/UseRetina"
    }
  }
}
